{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "synthetic": {
      "type": "boolean"
    },
    "trip": {
      "type": "object",
      "properties": {
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "arrival": {
          "type": "string",
          "format": "date"
        },
        "departure": {
          "type": "string",
          "format": "date"
        },
        "nights": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "destination",
        "timezone",
        "arrival",
        "departure",
        "nights",
        "currency"
      ],
      "additionalProperties": false
    },
    "requested_campsites": {
      "type": "integer",
      "minimum": 1
    },
    "shortfall_reason": {
      "type": "string",
      "minLength": 1
    },
    "campsites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "booking_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "availability": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "available",
                  "unavailable",
                  "unknown",
                  "request_required"
                ]
              },
              "arrival": {
                "type": "string",
                "format": "date"
              },
              "departure": {
                "type": "string",
                "format": "date"
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              },
              "source_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "arrival",
              "departure"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "available",
                        "unavailable",
                        "request_required"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "checked_at",
                    "source_url",
                    "scope"
                  ]
                }
              }
            ]
          },
          "quote": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "arrival": {
                    "type": "string",
                    "format": "date"
                  },
                  "departure": {
                    "type": "string",
                    "format": "date"
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "checked_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "source_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://"
                  },
                  "nightly_rates": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "subtotal": {
                    "type": "number",
                    "minimum": 0
                  },
                  "discount": {
                    "type": "object",
                    "properties": {
                      "eligible_amount": {
                        "type": "number",
                        "minimum": 0
                      },
                      "fraction": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "amount": {
                        "type": "number",
                        "minimum": 0
                      },
                      "eligibility_verified": {
                        "type": "boolean"
                      },
                      "conditions": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "eligible_amount",
                      "fraction",
                      "amount",
                      "eligibility_verified",
                      "conditions"
                    ],
                    "additionalProperties": false
                  },
                  "known_fees": {
                    "type": "number",
                    "minimum": 0
                  },
                  "total": {
                    "type": "number",
                    "minimum": 0
                  },
                  "excluded_or_unknown_fees": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "minor_unit_digits": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4,
                    "description": "Currency rounding precision; discount arithmetic uses round-half-up at this precision. Model other provider rounding policies separately."
                  }
                },
                "required": [
                  "currency",
                  "arrival",
                  "departure",
                  "scope",
                  "checked_at",
                  "source_url",
                  "nightly_rates",
                  "subtotal",
                  "discount",
                  "known_fees",
                  "total",
                  "excluded_or_unknown_fees",
                  "minor_unit_digits"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "booking_url",
          "availability"
        ],
        "additionalProperties": false
      }
    },
    "meal_ideas": {
      "type": "object",
      "properties": {
        "requested": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "requested",
        "items"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "trip",
    "requested_campsites",
    "campsites"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Camping trip portable core",
  "description": "Structural schema; apply validate_plan.py for cross-field invariants. Example data are synthetic, not travel advice or actual inventory."
}
